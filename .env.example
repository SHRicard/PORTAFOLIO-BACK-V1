# Copiá este archivo como .env y completá los valores
# cp .env.example .env

NODE_ENV=development
PORT=4000

# MongoDB local:  mongodb://127.0.0.1:27017/mi_proyecto
# MongoDB Atlas:  mongodb+srv://usuario:password@cluster.mongodb.net/mi_proyecto
MONGODB_URI=mongodb://127.0.0.1:27017/mi_proyecto

# Clave secreta para firmar los tokens (mínimo 32 caracteres, usá una aleatoria)
# Generar una:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=cambia-esto-por-una-clave-larga-y-aleatoria-de-32-o-mas-caracteres
JWT_EXPIRES_IN=7d

# URLs del front que pueden llamar a la API (separadas por coma)
CORS_ORIGIN=http://localhost:5173,http://localhost:3000

# true = cualquiera puede registrarse | false = registro cerrado (ideal para panel privado)
ALLOW_REGISTRATION=true

# Días que se guardan los logs de auditoría antes de que MongoDB los borre solo
LOG_RETENTION_DAYS=90

# Correo del único usuario que puede editar el portafolio desde el panel (obligatoria)
# Tiene que ser el mismo correo con el que te registrás en /api/users/register
ADMIN_CORREO=tu-correo@ejemplo.com

# Cloudinary: subida de imágenes y PDF desde el panel (Dashboard -> Settings -> API Keys)
# Si quedan vacías, el servidor arranca igual pero firmar, registrar y borrar archivos responden 503
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Carpeta de Cloudinary donde se guarda todo (minúsculas, números, guiones y /)
CLOUDINARY_CARPETA=portafolio

# Amazon S3: subida de APK desde el panel (pasos en docs/ARCHIVOS.md, sección 6)
AWS_S3_BUCKET=
AWS_S3_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
